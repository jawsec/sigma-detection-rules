<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-maintained, experimental Wazuh 4.x examples. NOT a complete conversion.
  Four selectors only. Parent rules checked against Wazuh v4.14.0 source.
  XML parsing is not Wazuh rule compilation. wazuh-logtest has NOT been run.
  Validate locally before deployment; see README.md in this directory.
  Current ATT&CK mappings remain in the Sigma sources, not an older manager DB.
-->
<group name="kino_sigma,">
  <!-- rules/defense-impairment/windows_security_log_cleared.yml -->
  <rule id="110003" level="10">
    <if_sid>60001</if_sid>
    <field name="win.system.eventID">^1102$</field>
    <description>Kino: Windows Security log cleared; verify actor and change record</description>
    <group>windows,log_cleared,</group>
  </rule>
  <!-- rules/stealth/file_creation_time_changed.yml -->
  <rule id="110004" level="3">
    <if_group>sysmon_event2</if_group>
    <field name="win.eventdata.image" type="pcre2">(?s)^.*$</field>
    <description>Kino hunt: File creation time changed; not proof of timestomping</description>
    <group>windows,sysmon,hunting,</group>
  </rule>
  <!-- rules/privilege-escalation/user_added_local_admins.yml -->
  <rule id="110007" level="7">
    <if_sid>60001</if_sid>
    <field name="win.system.eventID">^4732$</field>
    <field name="win.eventdata.targetSid">^S-1-5-32-544$</field>
    <description>Kino: Member added to local Administrators; verify authorization</description>
    <group>windows,account_changed,</group>
  </rule>
  <!-- rules/crypto-web3-threats/mining_pool_dns_query.yml -->
  <rule id="110012" level="7">
    <if_group>sysmon_event_22</if_group>
    <field name="win.eventdata.queryName" type="pcre2">(?i)^(?:[^.]+\.)*(?:supportxmr\.com|moneroocean\.stream|2miners\.com)\.?$</field>
    <description>Kino: Mining pool domain queried; no connection or mining confirmed</description>
    <group>windows,sysmon,mining_pool_dns,</group>
  </rule>
</group>
